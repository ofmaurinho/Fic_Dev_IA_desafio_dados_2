<?xml version="1.0" encoding="UTF-8"?>
<pipeline>
  <info>
    <pipeline_version>1.0</pipeline_version>
    <capture_transform_performance>N</capture_transform_performance>
    <transform_performance_capturing_delay>1000</transform_performance_capturing_delay>
    <transform_performance_capturing_size_limit>100</transform_performance_capturing_size_limit>
    <pipeline_type>Normal</pipeline_type>
    <pipeline_status>0</pipeline_status>
    <parameters/>
    <name>reprocessar_quarentena</name>
    <name_sync_with_filename>Y</name_sync_with_filename>
    <description>Identifica arquivos da quarentena, aplica correções controladas e gera novamente o mesmo formato da fonte.</description>
    <extended_description>O pipeline não executa validações Silver. Ele identifica catalogo.csv, interacoes.json e comentarios.json, aplica somente correções de recuperação configuradas e gera arquivos corrigidos para nova execução dos respectivos pipelines Silver.</extended_description>
    <created_user>-</created_user>
    <modified_user>-</modified_user>
    <created_date>2026/09/27 00:00:00.000</created_date>
    <modified_date>2026/09/27 00:00:00.000</modified_date>
  </info>
  <transform>
    <type>GetFileNames</type>
    <name>Listar arquivos da quarentena</name>
    <file>
      <name>${QUARENTENA_HOME}</name>
      <filemask>.*\.(csv|json)$</filemask>
      <exclude_filemask>.*_reprocessado\.(csv|json)$</exclude_filemask>
      <file_required>N</file_required>
      <include_subfolders>N</include_subfolders>
    </file>
    <filter>
      <filterfiletype>only_files</filterfiletype>
    </filter>
    <rownum>N</rownum>
    <filename_Field/>
    <wildcard_Field/>
    <exclude_wildcard_Field/>
    <filefield>N</filefield>
    <dynamic_include_subfolders>N</dynamic_include_subfolders>
    <isaddresult>N</isaddresult>
    <limit>0</limit>
    <doNotFailIfNoFile>Y</doNotFailIfNoFile>
    <raiseAnExceptionIfNoFile>N</raiseAnExceptionIfNoFile>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>96</xloc>
      <yloc>320</yloc>
    </GUI>
    <description>Lista somente arquivos da área de quarentena, ignorando arquivos já reprocessados.</description>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>SwitchCase</type>
    <name>Identificar arquivo</name>
    <fieldname>short_filename</fieldname>
    <case_value_type>String</case_value_type>
    <case_value_format/>
    <case_value_decimal/>
    <case_value_group/>
    <cases>
      <case>
        <value>catalogo.csv</value>
      </case>
      <case>
        <value>interacoes.json</value>
        <target_transform>INTERACOES - Entrada da quarentena</target_transform>
      </case>
      <case>
        <value>comentarios.json</value>
      </case>
    </cases>
    <default_target_transform>Arquivo não suportado</default_target_transform>
    <use_contains>N</use_contains>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>320</xloc>
      <yloc>320</yloc>
    </GUI>
    <description>Identifica o formato e o conjunto de dados da quarentena.</description>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>Dummy</type>
    <name>Arquivo não suportado</name>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>320</xloc>
      <yloc>192</yloc>
    </GUI>
    <description>Destino para arquivos diferentes dos três conjuntos previstos.</description>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>ValueMapper</type>
    <name>INTERACOES - Corrigir valores permitidos</name>
    <field_to_use>tipo_interacao</field_to_use>
    <target_field/>
    <non_match_default/>
    <keep_original_value_on_non_match>Y</keep_original_value_on_non_match>
    <target_type/>
    <fields>
      <field>
        <source_value>teste_invalido</source_value>
        <target_value>conclusão</target_value>
        <empty_string_equals_null>Y</empty_string_equals_null>
      </field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>848</xloc>
      <yloc>320</yloc>
    </GUI>
    <description>Correção controlada demonstrada no RF23: teste_invalido para conclusão.</description>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>JsonOutput</type>
    <name>INTERACOES - Arquivo corrigido</name>
    <operation_type>writetofile</operation_type>
    <encoding>UTF-8</encoding>
    <outputValue>outputValue</outputValue>
    <jsonBloc>data</jsonBloc>
    <nrRowsInBloc>0</nrRowsInBloc>
    <fields>
      <field>
        <name>avaliacao_atribuida</name>
        <element>avaliacao_atribuida</element>
      </field>
      <field>
        <name>conteudo_id</name>
        <element>conteudo_id</element>
      </field>
      <field>
        <name>data_hora</name>
        <element>data_hora</element>
      </field>
      <field>
        <name>data_ingestao</name>
        <element>data_ingestao</element>
      </field>
      <field>
        <name>id_execucao</name>
        <element>id_execucao</element>
      </field>
      <field>
        <name>origem</name>
        <element>origem</element>
      </field>
      <field>
        <name>percentual_conclusao</name>
        <element>percentual_conclusao</element>
      </field>
      <field>
        <name>tempo_consumido</name>
        <element>tempo_consumido</element>
      </field>
      <field>
        <name>tipo_interacao</name>
        <element>tipo_interacao</element>
      </field>
      <field>
        <name>usuario_id</name>
        <element>usuario_id</element>
      </field>
    </fields>
    <addToResult>N</addToResult>
    <fileAppended>N</fileAppended>
    <createParentFolder>Y</createParentFolder>
    <doNotOpenNewFileInit>Y</doNotOpenNewFileInit>
    <transformNrInFilename>N</transformNrInFilename>
    <partNrInFilename>N</partNrInFilename>
    <dateInFilename>N</dateInFilename>
    <timeInFilename>N</timeInFilename>
    <extension/>
    <fileName>${QUARENTENA_HOME}/reprocessados/interacoes_reprocessado.json</fileName>
    <fileAsCommand>N</fileAsCommand>
    <specifyingFormat>N</specifyingFormat>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>1104</xloc>
      <yloc>320</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <transform>
    <type>JsonNormalizeInput</type>
    <name>INTERACOES - Entrada da quarentena</name>
    <include>N</include>
    <include_field/>
    <rownum>N</rownum>
    <rownum_field/>
    <limit>0</limit>
    <valueField>filename</valueField>
    <IsInFields>N</IsInFields>
    <IsAFile>N</IsAFile>
    <addresultfile>N</addresultfile>
    <IsIgnoreEmptyFile>N</IsIgnoreEmptyFile>
    <doNotFailIfNoFile>Y</doNotFailIfNoFile>
    <readurl>N</readurl>
    <removeSourceField>N</removeSourceField>
    <recordPath>$.data[*]</recordPath>
    <fieldSeparator>.</fieldSeparator>
    <maxFlattenDepth>-1</maxFlattenDepth>
    <arrayHandling>STRINGIFY</arrayHandling>
    <beyondDepthBehavior>STRINGIFY</beyondDepthBehavior>
    <ignoreMissingField>Y</ignoreMissingField>
    <files>
      <file>
        <name>${QUARENTENA_HOME}/interacoes.json</name>
        <filemask/>
        <exclude_filemask/>
        <file_required>N</file_required>
        <include_subfolders>N</include_subfolders>
      </file>
    </files>
    <fields>
      <field>
        <name>avaliacao_atribuida</name>
        <length>-1</length>
        <type>Number</type>
        <format/>
        <trim_type>none</trim_type>
        <precision>-1</precision>
        <currency/>
        <decimal/>
        <group/>
        <repeat>N</repeat>
        <path>avaliacao_atribuida</path>
      </field>
      <field>
        <name>conteudo_id</name>
        <length>-1</length>
        <type>String</type>
        <format/>
        <trim_type>none</trim_type>
        <precision>-1</precision>
        <currency/>
        <decimal/>
        <group/>
        <repeat>N</repeat>
        <path>conteudo_id</path>
      </field>
      <field>
        <name>data_hora</name>
        <length>-1</length>
        <type>String</type>
        <format/>
        <trim_type>none</trim_type>
        <precision>-1</precision>
        <currency/>
        <decimal/>
        <group/>
        <repeat>N</repeat>
        <path>data_hora</path>
      </field>
      <field>
        <name>data_ingestao</name>
        <length>-1</length>
        <type>String</type>
        <format/>
        <trim_type>none</trim_type>
        <precision>-1</precision>
        <currency/>
        <decimal/>
        <group/>
        <repeat>N</repeat>
        <path>data_ingestao</path>
      </field>
      <field>
        <name>id_execucao</name>
        <length>-1</length>
        <type>String</type>
        <format/>
        <trim_type>none</trim_type>
        <precision>-1</precision>
        <currency/>
        <decimal/>
        <group/>
        <repeat>N</repeat>
        <path>id_execucao</path>
      </field>
      <field>
        <name>origem</name>
        <length>-1</length>
        <type>String</type>
        <format/>
        <trim_type>none</trim_type>
        <precision>-1</precision>
        <currency/>
        <decimal/>
        <group/>
        <repeat>N</repeat>
        <path>origem</path>
      </field>
      <field>
        <name>percentual_conclusao</name>
        <length>-1</length>
        <type>String</type>
        <format/>
        <trim_type>none</trim_type>
        <precision>-1</precision>
        <currency/>
        <decimal/>
        <group/>
        <repeat>N</repeat>
        <path>percentual_conclusao</path>
      </field>
      <field>
        <name>tempo_consumido</name>
        <length>-1</length>
        <type>String</type>
        <format/>
        <trim_type>none</trim_type>
        <precision>-1</precision>
        <currency/>
        <decimal/>
        <group/>
        <repeat>N</repeat>
        <path>tempo_consumido</path>
      </field>
      <field>
        <name>tipo_interacao</name>
        <length>-1</length>
        <type>String</type>
        <format/>
        <trim_type>none</trim_type>
        <precision>-1</precision>
        <currency/>
        <decimal/>
        <group/>
        <repeat>N</repeat>
        <path>tipo_interacao</path>
      </field>
      <field>
        <name>usuario_id</name>
        <length>-1</length>
        <type>String</type>
        <format/>
        <trim_type>none</trim_type>
        <precision>-1</precision>
        <currency/>
        <decimal/>
        <group/>
        <repeat>N</repeat>
        <path>usuario_id</path>
      </field>
    </fields>
    <distribute>Y</distribute>
    <copies>1</copies>
    <GUI>
      <xloc>544</xloc>
      <yloc>320</yloc>
    </GUI>
    <partitioning>
      <method>none</method>
      <schema_name/>
    </partitioning>
    <attributes/>
  </transform>
  <order>
    <hop>
      <from>Listar arquivos da quarentena</from>
      <to>Identificar arquivo</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Identificar arquivo</from>
      <to>Arquivo não suportado</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>INTERACOES - Corrigir valores permitidos</from>
      <to>INTERACOES - Arquivo corrigido</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>Identificar arquivo</from>
      <to>INTERACOES - Entrada da quarentena</to>
      <enabled>Y</enabled>
    </hop>
    <hop>
      <from>INTERACOES - Entrada da quarentena</from>
      <to>INTERACOES - Corrigir valores permitidos</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <notepads/>
  <attributes/>
  <transform_error_handling/>
</pipeline>
