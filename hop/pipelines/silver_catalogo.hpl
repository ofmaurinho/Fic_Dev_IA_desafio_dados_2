    <compare>
      <condition>
        <negated>N</negated>
        <operator>-</operator>
        <leftvalue>tipo</leftvalue>
        <function>IN LIST</function>
        <value>
          <name>constant</name>
          <type>String</type>
          <text>Curso;Podcast;Artigo;Vídeo</text>
          <length>-1</length>
          <precision>-1</precision>
          <isnull>N</isnull>
          <mask/>
        </value>
        <conditions>
          <condition>
            <negated>N</negated>
            <operator>-</operator>
            <leftvalue>tipo</leftvalue>
            <function>IN LIST</function>
            <value>
              <name>constant</name>
