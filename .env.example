# Copie para .env (não versionado) e preencha. Os scripts Python leem este
# arquivo; as variáveis PG* seguem o padrão da libpq.

# PostgreSQL do Desafio 1 (fontes, quality gate e camada Gold)
PGHOST=localhost
PGPORT=5433
PGDATABASE=desafio_dados
PGUSER=postgres
PGPASSWORD=sua_senha_aqui

# Diretórios das camadas (padrão: dados/<camada>)
# BRONZE_HOME=dados/bronze
# SILVER_HOME=dados/silver
# QUARENTENA_HOME=dados/quarentena
